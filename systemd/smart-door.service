[Unit]
Description=Smart Door Facial Recognition System
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Smart-Door-Facial-Recognition
ExecStart=/usr/bin/python3 /home/pi/Smart-Door-Facial-Recognition/src/smart_door.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
